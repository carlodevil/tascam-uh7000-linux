{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/carlodevil/tascam-uh7000-linux/docs/report-schema.json",
  "title": "UH-7000 state and diagnostic report",
  "type": "object",
  "required": ["schema", "version", "device", "audio_topology", "mixer", "effects", "safety"],
  "properties": {
    "schema": {"const": "io.github.carlodevil.UH7000.State.v1"},
    "version": {"type": "string"},
    "device": {
      "type": "object",
      "required": ["connected", "driver_bound"],
      "properties": {
        "connected": {"type": "boolean"},
        "usb_configuration": {"type": ["integer", "null"]},
        "driver_bound": {"type": "boolean"}
      }
    },
    "audio_topology": {
      "type": "object",
      "required": ["playback_channels", "capture_channels", "explicit_feedback"],
      "properties": {
        "playback_channels": {"type": "integer", "const": 4},
        "capture_channels": {"type": "integer", "const": 6},
        "explicit_feedback": {"type": ["boolean", "null"]}
      }
    },
    "mixer": {"type": "object"},
    "effects": {"type": "object"},
    "safety": {
      "type": "object",
      "required": ["safe_for_playback", "refusal_reasons"],
      "properties": {
        "safe_for_playback": {"type": "boolean"},
        "refusal_reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "protocol": {"type": "object"}
  }
}
