#!/bin/sh
set -e

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi
if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules >/dev/null 2>&1 || true
    # The device rule deliberately matches only real add events.  Replaying an
    # add event here also gives an already-connected device its uaccess ACL.
    udevadm trigger --action=add --subsystem-match=usb --attr-match=idVendor=0644 --attr-match=idProduct=8048 >/dev/null 2>&1 || true
fi

#DEBHELPER#
exit 0
