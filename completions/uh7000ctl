# shellcheck shell=bash
# bash completion for uh7000ctl

_uh7000ctl()
{
    local cur commands
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    commands="status topology state diagnostics selector-status state-dump configure preflight playback-plan playback-test"

    if [ "$COMP_CWORD" -eq 1 ]; then
        mapfile -t COMPREPLY < <(compgen -W "$commands" -- "$cur")
        return 0
    fi

    case "${COMP_WORDS[1]}" in
        preflight|playback-test)
            mapfile -t COMPREPLY < <(compgen -W "--speakers-disconnected --attenuated-loopback --baseline-peak-dbfs" -- "$cur")
            ;;
    esac
}

complete -F _uh7000ctl uh7000ctl
