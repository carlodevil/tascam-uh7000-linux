# TASCAM UH-7000 USB audio interface.
# The device powers up in vendor-specific configuration 1. Configuration 2
# exposes USB Audio 2.0 interfaces that can bind to snd_usb_audio.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0644", ATTR{idProduct}=="8048", TAG+="systemd", ENV{SYSTEMD_WANTS}+="tascam-uh7000-configure@%k.service"
