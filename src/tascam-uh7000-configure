#!/bin/sh
set -eu

VID="0644"
PID="8048"
TARGET_CONFIG="2"
CONFIGURE_ATTEMPTS="8"
LOG_TAG="tascam-uh7000"
CONFIGURATION_LOCK="/run/tascam-uh7000/configuration.lock"

log() {
    if command -v logger >/dev/null 2>&1; then
        logger -t "$LOG_TAG" -- "$*"
    fi
    printf '%s\n' "$*" >&2
}

find_device_by_kernel() {
    kernel="$1"
    path="/sys/bus/usb/devices/$kernel"
    if [ -f "$path/idVendor" ] && [ -f "$path/idProduct" ]; then
        if [ "$(cat "$path/idVendor")" = "$VID" ] && [ "$(cat "$path/idProduct")" = "$PID" ]; then
            printf '%s\n' "$path"
            return 0
        fi
    fi
    return 1
}

find_first_device() {
    for path in /sys/bus/usb/devices/*; do
        [ -f "$path/idVendor" ] || continue
        [ -f "$path/idProduct" ] || continue
        [ "$(cat "$path/idVendor")" = "$VID" ] || continue
        [ "$(cat "$path/idProduct")" = "$PID" ] || continue
        printf '%s\n' "$path"
        return 0
    done
    return 1
}

usage() {
    cat <<EOF
Usage: tascam-uh7000-configure [USB_KERNEL_NAME]

Switches a TASCAM UH-7000 (USB ID ${VID}:${PID}) to USB configuration ${TARGET_CONFIG}
so Linux can bind its USB Audio 2.0 interfaces with snd_usb_audio.
EOF
}

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
esac

if [ "$(id -u)" -ne 0 ]; then
    log "must run as root"
    exit 1
fi

# A live configuration-1 stream holds this advisory lock before changing USB
# configuration. Its change event must not force UAC2 back underneath usbfs.
if [ -e "$CONFIGURATION_LOCK" ] && command -v flock >/dev/null 2>&1; then
    exec 9>"$CONFIGURATION_LOCK"
    if ! flock -n 9; then
        log "configuration-1 stream is active; deferring UAC2 selection"
        exit 0
    fi
fi

devpath=""
if [ "${1:-}" ]; then
    devpath="$(find_device_by_kernel "$1" || true)"
fi

if [ -z "$devpath" ]; then
    devpath="$(find_first_device || true)"
fi

if [ -z "$devpath" ]; then
    log "UH-7000 ${VID}:${PID} not found"
    exit 2
fi

if [ ! -w "$devpath/bConfigurationValue" ]; then
    log "cannot write $devpath/bConfigurationValue"
    exit 3
fi

num_configs="$(cat "$devpath/bNumConfigurations" 2>/dev/null || printf '0')"
current_config="$(cat "$devpath/bConfigurationValue" 2>/dev/null || printf '?')"

if [ "$num_configs" -lt "$TARGET_CONFIG" ] 2>/dev/null; then
    log "device exposes only $num_configs configuration(s), cannot select $TARGET_CONFIG"
    exit 4
fi

attempt=1
while [ "$current_config" != "$TARGET_CONFIG" ] && [ "$attempt" -le "$CONFIGURE_ATTEMPTS" ]; do
    log "selecting USB configuration $TARGET_CONFIG at $(basename "$devpath") (attempt $attempt/$CONFIGURE_ATTEMPTS; current $current_config)"
    printf '%s' "$TARGET_CONFIG" > "$devpath/bConfigurationValue"
    sleep 1
    current_config="$(cat "$devpath/bConfigurationValue" 2>/dev/null || printf '?')"
    attempt=$((attempt + 1))
done

if [ "$current_config" != "$TARGET_CONFIG" ]; then
    log "USB configuration $TARGET_CONFIG did not remain selected after $CONFIGURE_ATTEMPTS attempts (current $current_config)"
    exit 5
fi

if [ "$attempt" -eq 1 ]; then
    log "UH-7000 already in USB configuration $TARGET_CONFIG"
else
    log "UH-7000 is in USB configuration $TARGET_CONFIG"
fi

if command -v modprobe >/dev/null 2>&1; then
    modprobe snd_usb_audio 2>/dev/null || true
fi

if [ -w /sys/bus/usb/drivers/snd-usb-audio/new_id ]; then
    if printf '%s %s' "$VID" "$PID" > /sys/bus/usb/drivers/snd-usb-audio/new_id 2>/dev/null; then
        log "registered UH-7000 with snd-usb-audio"
    else
        log "snd-usb-audio new_id registration failed or was already present"
    fi
else
    log "snd-usb-audio new_id interface is unavailable"
fi

exit 0
