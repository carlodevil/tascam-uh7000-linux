import ctypes
import fcntl
import os
from pathlib import Path
import sys

VID = "0644"
PID = "8048"
PAGES = (0x007C, 0x007D, 0x007E, 0x007F)
PAGE_LENGTH = 512
IMAGE_LENGTH = PAGE_LENGTH * len(PAGES)

USBDEVFS_IOCTL_TYPE = ord("U")
USBDEVFS_IOCTL_NR_CONTROL = 0
IOC_WRITE = 1
IOC_READ = 2
IOC_DIRSHIFT = 30
IOC_SIZESHIFT = 16
IOC_TYPESHIFT = 8
IOC_NRSHIFT = 0


class UsbdevfsCtrlTransfer(ctypes.Structure):
    _fields_ = [
        ("bRequestType", ctypes.c_uint8),
        ("bRequest", ctypes.c_uint8),
        ("wValue", ctypes.c_uint16),
        ("wIndex", ctypes.c_uint16),
        ("wLength", ctypes.c_uint16),
        ("timeout", ctypes.c_uint32),
        ("data", ctypes.c_void_p),
    ]


USBDEVFS_CONTROL = (
    ((IOC_READ | IOC_WRITE) << IOC_DIRSHIFT)
    | (ctypes.sizeof(UsbdevfsCtrlTransfer) << IOC_SIZESHIFT)
    | (USBDEVFS_IOCTL_TYPE << IOC_TYPESHIFT)
    | (USBDEVFS_IOCTL_NR_CONTROL << IOC_NRSHIFT)
)


def read_text(path):
    try:
        return path.read_text(encoding="ascii").strip()
    except OSError:
        return None


def find_devices():
    devices = []
    for path in Path("/sys/bus/usb/devices").iterdir():
        if read_text(path / "idVendor") != VID:
            continue
        if read_text(path / "idProduct") != PID:
            continue
        bus = read_text(path / "busnum")
        dev = read_text(path / "devnum")
        if bus is None or dev is None:
            continue
        devices.append((str(path), bus, dev))
    return devices


def vendor_read(devpath: str, request: int, index: int, length: int) -> bytes:
    buf = ctypes.create_string_buffer(length)
    transfer = UsbdevfsCtrlTransfer(
        0xC0,
        request,
        0,
        index,
        length,
        1000,
        ctypes.cast(buf, ctypes.c_void_p).value,
    )
    fd = os.open(devpath, os.O_RDWR)
    try:
        transferred = fcntl.ioctl(fd, USBDEVFS_CONTROL, transfer)
    finally:
        os.close(fd)
    return bytes(buf.raw[:transferred])


def vendor_write(devpath: str, request: int, index: int, payload: bytes) -> int:
    buf = ctypes.create_string_buffer(payload, len(payload))
    transfer = UsbdevfsCtrlTransfer(
        0x40,
        request,
        0,
        index,
        len(payload),
        1000,
        ctypes.cast(buf, ctypes.c_void_p).value,
    )
    fd = os.open(devpath, os.O_RDWR)
    try:
        return fcntl.ioctl(fd, USBDEVFS_CONTROL, transfer)
    finally:
        os.close(fd)


def image_sum_be_words(data: bytes) -> int:
    total = 0
    for offset in range(0, len(data), 4):
        total = (total + int.from_bytes(data[offset : offset + 4], "big")) & 0xFFFFFFFF
    return total


def write_pages(devpath: str, image: bytes) -> None:
    for index, page in enumerate(PAGES):
        chunk = image[index * PAGE_LENGTH : (index + 1) * PAGE_LENGTH]
        transferred = vendor_write(devpath, 0x55, page, chunk)
        if transferred != len(chunk):
            raise RuntimeError(
                f"page 0x{page:04x} transferred {transferred}, expected {len(chunk)}"
            )
        readback = vendor_read(devpath, 0x55, page, PAGE_LENGTH)
        if readback != chunk:
            raise RuntimeError(f"page 0x{page:04x} readback mismatch after write")
        print(f"{devpath}: wrote and verified 0x55 page 0x{page:04x}")


mode = sys.argv[1]
image_path = Path(sys.argv[2])
backup_path = Path(sys.argv[3]) if len(sys.argv) > 3 and sys.argv[3] else None

if mode not in {"upload", "restore"}:
    raise SystemExit(f"unknown mode {mode!r}")
try:
    image = image_path.read_bytes()
except OSError as exc:
    raise SystemExit(f"cannot read {image_path}: {exc}")
if len(image) != IMAGE_LENGTH:
    raise SystemExit(f"{image_path} is {len(image)} bytes; expected {IMAGE_LENGTH}")

if mode == "upload":
    checksum = image_sum_be_words(image)
    if checksum != 0:
        raise SystemExit(
            f"{image_path} has checksum sum 0x{checksum:08x}; expected 0x00000000"
        )

devices = find_devices()
if len(devices) != 1:
    raise SystemExit(f"expected exactly one UH-7000, found {len(devices)}")

_sysfs, bus, dev = devices[0]
devpath = f"/dev/bus/usb/{int(bus):03d}/{int(dev):03d}"
current = b"".join(vendor_read(devpath, 0x55, page, PAGE_LENGTH) for page in PAGES)
if len(current) != IMAGE_LENGTH:
    raise SystemExit(f"read {len(current)} bytes from existing 0xf800 pages; expected {IMAGE_LENGTH}")
if backup_path is not None:
    backup_path.write_bytes(current)
    print(f"{devpath}: saved current 0xf800 pages to {backup_path}")

try:
    write_pages(devpath, image)
except Exception as exc:
    if mode == "upload":
        print(f"{devpath}: upload failed: {exc}; attempting rollback", file=sys.stderr)
        try:
            write_pages(devpath, current)
        except Exception as rollback_exc:
            raise SystemExit(f"rollback failed after upload error: {rollback_exc}") from exc
    raise

print(f"{devpath}: {mode} complete for request 0x55 pages 0x007c..0x007f")
PY
}

f800_upload() {
    require_root
    require_experimental_0x55_write

    image="${1:-}"
    if [ -z "$image" ]; then
        printf 'Usage: UH7000_EXPERIMENTAL_0X55_WRITE=1 sudo -E uh7000ctl f800-upload IMAGE.bin\n' >&2
        exit 64
    fi
    if [ ! -r "$image" ]; then
        printf 'Cannot read image file %s\n' "$image" >&2
        exit 66
    fi

    printf 'UH-7000 f800-upload: experimental request 0x55 write path\n'
    printf 'Running preflight before writing any 0x55 page.\n\n'
    preflight 1

    backup="$(mktemp /tmp/uh7000-f800-backup.XXXXXX.bin)"
    if ! f800_transfer upload "$image" "$backup"; then
        printf 'FAIL f800-upload: transfer failed; backup path was %s\n' "$backup" >&2
        exit 1
    fi

    printf '\nCapture health after f800 upload:\n'
    if capture_health 1; then
        printf 'PASS f800-upload: capture stayed clean after upload\n'
        printf 'Backup image: %s\n' "$backup"
        return 0
    fi

    printf 'FAIL f800-upload: capture clipped or failed after upload; restoring backup %s\n' "$backup" >&2
    if f800_transfer restore "$backup" ""; then
        printf '\nCapture health after f800 rollback:\n'
        capture_health 1 || true
    fi
    exit 1
}

f800_restore() {
    require_root
    require_experimental_0x55_write

    image="${1:-}"
    if [ -z "$image" ]; then
        printf 'Usage: UH7000_EXPERIMENTAL_0X55_WRITE=1 sudo -E uh7000ctl f800-restore BACKUP.bin\n' >&2
        exit 64
    fi
    if [ ! -r "$image" ]; then
        printf 'Cannot read restore image file %s\n' "$image" >&2
        exit 66
    fi

    backup="$(mktemp /tmp/uh7000-f800-before-restore.XXXXXX.bin)"
    f800_transfer restore "$image" "$backup"
    printf '\nCapture health after f800 restore:\n'
    capture_health 1 || true
    printf 'Pre-restore image saved to %s\n' "$backup"
}

capture_health() {
    duration="${1:-2}"
    case "$duration" in
        ''|*[!0-9]*)
            printf 'capture-health duration must be an integer number of seconds.\n' >&2
            exit 64
            ;;
    esac

    python3 - "$duration" <<'PY'
import math
import os
import subprocess
import sys
import tempfile

duration = int(sys.argv[1])
rate = 48000
channels = 6
sample_bytes = 3
frame_bytes = channels * sample_bytes

with tempfile.NamedTemporaryFile(prefix="uh7000-capture-", suffix=".raw", delete=False) as tmp:
    path = tmp.name

try:
    result = subprocess.run(
        [
            "arecord",
            "-q",
            "-t",
            "raw",
            "-D",
            "hw:UH7000,0",
            "-f",
            "S24_3LE",
            "-c",
            str(channels),
            "-r",
            str(rate),
            "-d",
            str(duration),
            path,
        ],
        timeout=duration + 5,
    )
    if result.returncode != 0:
        raise SystemExit(result.returncode)

    with open(path, "rb") as handle:
        data = handle.read()
finally:
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass

frames = len(data) // frame_bytes
if frames == 0:
    raise SystemExit("capture produced no frames")

peaks = [0.0] * channels
sums = [0.0] * channels
clips = [0] * channels

for frame in range(frames):
    base = frame * frame_bytes
    for ch in range(channels):
        off = base + ch * sample_bytes
        value = data[off] | (data[off + 1] << 8) | (data[off + 2] << 16)
        if value & 0x800000:
            value -= 1 << 24
        normalized = value / 8388608.0
        absolute = abs(normalized)
        peaks[ch] = max(peaks[ch], absolute)
        sums[ch] += normalized * normalized
        if absolute >= 0.999:
            clips[ch] += 1

def dbfs(value: float) -> str:
    if value <= 0:
        return "-inf"
    return f"{20 * math.log10(value):.1f}"

print(f"Captured {frames} frames at {rate} Hz from hw:UH7000,0")
bad = False
clipped_channels = []
clip_count_total = 0
for ch in range(channels):
    rms = math.sqrt(sums[ch] / frames)
    if clips[ch]:
        bad = True
        clipped_channels.append(ch + 1)
        clip_count_total += clips[ch]
    print(
        f"ch{ch + 1}: peak={dbfs(peaks[ch]):>6} dBFS "
        f"rms={dbfs(rms):>6} dBFS clips={clips[ch]}"
    )

if clipped_channels:
    if clipped_channels == list(range(1, channels + 1)):
        clip_pattern = "all-channels"
    elif clipped_channels == [1, 3, 5]:
        clip_pattern = "odd-input-mirror"
    elif clipped_channels == [2, 4, 6]:
        clip_pattern = "even-input-mirror"
    else:
        clip_pattern = "partial"
    print(
        "clip-summary: "
        f"pattern={clip_pattern} clipped_channels={clipped_channels} "
        f"total_clips={clip_count_total}"
    )
    print(
        "recommendation: do not run output tests; disconnect loopback, "
        "power-cycle the UH-7000, then run sudo uh7000ctl preflight 2"
    )

if bad:
    raise SystemExit(1)
PY
}

input_noise() {
    duration="${1:-4}"
    case "$duration" in
        ''|*[!0-9]*)
            printf 'input-noise duration must be an integer number of seconds.\n' >&2
            exit 64
            ;;
    esac

    python3 - "$duration" <<'PY'
import math
import os
import subprocess
import sys
import tempfile

duration = int(sys.argv[1])
rate = 48000
channels = 6
sample_bytes = 3
frame_bytes = channels * sample_bytes


def dbfs(value: float) -> str:
    if value <= 0:
        return "-inf"
    return f"{20 * math.log10(value):.1f}"


def fft(values):
    n = len(values)
    data = [complex(value, 0.0) for value in values]
    j = 0
    for i in range(1, n):
        bit = n >> 1
        while j & bit:
            j ^= bit
            bit >>= 1
        j ^= bit
        if i < j:
            data[i], data[j] = data[j], data[i]
    size = 2
    while size <= n:
        half = size // 2
        step = -2.0 * math.pi / size
        w_size = complex(math.cos(step), math.sin(step))
        for start in range(0, n, size):
            w = 1 + 0j
            for k in range(start, start + half):
                even = data[k]
                odd = w * data[k + half]
                data[k] = even + odd
                data[k + half] = even - odd
                w *= w_size
        size *= 2
    return data


def spectral_summary(channel_samples):
    n = 32768
    if len(channel_samples) < n:
        return [], {}
    segment = channel_samples[:n]
    mean = sum(segment) / n
    windowed = []
    for i, sample in enumerate(segment):
        window = 0.5 - 0.5 * math.cos(2.0 * math.pi * i / (n - 1))
        windowed.append((sample - mean) * window)
    spectrum = fft(windowed)
    mags = [abs(spectrum[i]) for i in range(n // 2 + 1)]
    min_bin = max(1, int(10 * n / rate))
    peaks = []
    used = set()
    for idx in sorted(range(min_bin, n // 2), key=lambda i: mags[i], reverse=True):
        if any(abs(idx - prev) <= 3 for prev in used):
            continue
        used.add(idx)
        freq = idx * rate / n
        amplitude = mags[idx] * 4.0 / n
        peaks.append((freq, dbfs(amplitude)))
        if len(peaks) >= 8:
            break
    bands = [(10, 100), (100, 1000), (1000, 5000), (5000, 12000), (12000, 22000)]
    total = sum(mag * mag for mag in mags[min_bin : n // 2]) or 1.0
    powers = {}
    for lo, hi in bands:
        start = max(min_bin, int(lo * n / rate))
        end = min(n // 2, int(hi * n / rate))
        powers[f"{lo}-{hi}Hz"] = 100.0 * sum(mags[i] * mags[i] for i in range(start, end + 1)) / total
    return peaks, powers


def read_int24le(data: bytes, offset: int) -> int:
    value = data[offset] | (data[offset + 1] << 8) | (data[offset + 2] << 16)
    if value & 0x800000:
        value -= 1 << 24
    return value


with tempfile.NamedTemporaryFile(prefix="uh7000-input-noise-", suffix=".raw", delete=False) as tmp:
    path = tmp.name

try:
    result = subprocess.run(
        [
            "arecord",
            "-q",
            "-t",
            "raw",
            "-D",
            "hw:UH7000,0",
            "-f",
            "S24_3LE",
            "-c",
            str(channels),
            "-r",
            str(rate),
            "-d",
            str(duration),
            path,
        ],
        timeout=duration + 5,
    )
    if result.returncode != 0:
        raise SystemExit(result.returncode)

    with open(path, "rb") as handle:
        raw = handle.read()
finally:
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass

frames = len(raw) // frame_bytes
if frames == 0:
    raise SystemExit("capture produced no frames")

samples = [[] for _ in range(channels)]
for frame in range(frames):
    base = frame * frame_bytes
    for ch in range(channels):
        samples[ch].append(read_int24le(raw, base + ch * sample_bytes) / 8388608.0)

print("UH-7000 input-noise: capture-only analysis; no playback or mixer write was sent")
print(f"Captured {frames} frames ({frames / rate:.2f}s) from hw:UH7000,0")
print()

for ch, channel_samples in enumerate(samples, 1):
    peak = max(abs(value) for value in channel_samples)
    rms = math.sqrt(sum(value * value for value in channel_samples) / frames)
    mean = sum(channel_samples) / frames
    minv = min(channel_samples)
    maxv = max(channel_samples)
    positive_clips = sum(1 for value in channel_samples if value >= 0.999)
    negative_clips = sum(1 for value in channel_samples if value <= -0.999)
    clips = positive_clips + negative_clips
    crossings = sum(
        1
        for left, right in zip(channel_samples, channel_samples[1:])
        if (left < 0 <= right) or (left > 0 >= right)
    )
    zcr = crossings / max(1, frames - 1)
    peaks, bands = spectral_summary(channel_samples)
    print(
        f"ch{ch}: peak={dbfs(peak):>6} dBFS rms={dbfs(rms):>6} dBFS "
        f"dc={dbfs(abs(mean)):>6} dBFS clips={clips} ({100 * clips / frames:.3f}%) "
        f"+clips={positive_clips} -clips={negative_clips}"
    )
    print(f"     min={minv:+.4f} max={maxv:+.4f} zero_crossing_rate={zcr:.4f}")
    if peaks:
        peak_text = ", ".join(f"{freq:.1f}Hz/{level}dBFS" for freq, level in peaks[:6])
        band_text = ", ".join(f"{name}:{pct:.1f}%" for name, pct in bands.items())
        print(f"     strongest_bins: {peak_text}")
        print(f"     band_power: {band_text}")
    print()
PY
}

