preflight() {
    require_root

    duration="${1:-2}"
    case "$duration" in
        ''|*[!0-9]*)
            printf 'preflight duration must be an integer number of seconds.\n' >&2
            return 64
            ;;
    esac

    failed=0
    found=0

    printf 'UH-7000 preflight: no output playback or mixer write will be sent\n\n'

    for path in $(find_devices); do
        found=1
        config="$(cat "$path/bConfigurationValue" 2>/dev/null || printf '?')"
        if [ "$config" = "2" ]; then
            printf 'PASS usb-config: configuration 2 selected\n'
        else
            printf 'FAIL usb-config: configuration %s selected; run sudo uh7000ctl configure\n' "$config"
            failed=1
        fi

        for iface in 0 1 2; do
            link="$path:2.$iface/driver"
            if [ -L "$link" ] && [ "$(basename "$(readlink -f "$link")")" = "snd-usb-audio" ]; then
                printf 'PASS driver-if%s: snd-usb-audio bound\n' "$iface"
            else
                printf 'FAIL driver-if%s: snd-usb-audio is not bound\n' "$iface"
                failed=1
            fi
        done
    done

    if [ "$found" -eq 0 ]; then
        printf 'FAIL usb-device: UH-7000 %s:%s not found\n' "$VID" "$PID"
        return 2
    fi

    if grep -qi 'UH7000' /proc/asound/cards 2>/dev/null; then
        printf 'PASS alsa-card: UH7000 card is visible\n'
    else
        printf 'FAIL alsa-card: UH7000 card is not visible\n'
        failed=1
    fi

    stream_file=""
    for stream in /proc/asound/card*/stream*; do
        [ -r "$stream" ] || continue
        if grep -qiE 'UH-7000|TASCAM|TEAC' "$stream"; then
            stream_file="$stream"
            break
        fi
    done

    if [ -n "$stream_file" ]; then
        printf 'PASS alsa-stream: %s\n' "$stream_file"
        if grep -A12 '^Playback:' "$stream_file" | grep -q 'Format: S24_3LE' &&
           grep -A12 '^Playback:' "$stream_file" | grep -q 'Channels: 4'; then
            printf 'PASS playback-shape: 4ch S24_3LE stream exposed\n'
        else
            printf 'FAIL playback-shape: expected 4ch S24_3LE stream not found\n'
            failed=1
        fi
        if grep -A12 '^Capture:' "$stream_file" | grep -q 'Format: S24_3LE' &&
           grep -A12 '^Capture:' "$stream_file" | grep -q 'Channels: 6'; then
            printf 'PASS capture-shape: 6ch S24_3LE stream exposed\n'
        else
            printf 'FAIL capture-shape: expected 6ch S24_3LE stream not found\n'
            failed=1
        fi
        playback_section="$(sed -n '/^Playback:/,/^Capture:/p' "$stream_file")"
        sync_endpoint="$(printf '%s\n' "$playback_section" | sed -n 's/^[[:space:]]*Sync Endpoint: //p' | head -n 1)"
        implicit_feedback="$(printf '%s\n' "$playback_section" | sed -n 's/^[[:space:]]*Implicit Feedback Mode: //p' | head -n 1)"
        if [ -n "$sync_endpoint" ]; then
            printf 'INFO playback-feedback: sync endpoint %s; implicit feedback mode %s\n' \
                "$sync_endpoint" "${implicit_feedback:-unknown}"
        fi
        if printf '%s\n' "$sync_endpoint" | grep -q '^0x85 ' &&
           [ "${implicit_feedback:-}" = "No" ]; then
            printf 'PASS playback-feedback: explicit UH-7000 feedback endpoint is active\n'
        else
            printf 'FAIL playback-feedback: expected explicit sync endpoint 0x85 with implicit feedback mode No\n'
            printf 'recommendation: reload snd_usb_audio with implicit_fb=N before output tests\n'
            failed=1
        fi
    else
        printf 'FAIL alsa-stream: UH-7000 stream file not found\n'
        failed=1
    fi

    printf '\nVendor control status:\n'
    if control_status; then
        printf 'PASS control-status: request 0x49 responded\n'
    else
        printf 'FAIL control-status: request 0x49 did not respond\n'
        failed=1
    fi

    printf '\nCapture health:\n'
    if capture_health "$duration"; then
        printf 'PASS capture-health: no full-scale clips detected\n'
    else
        printf 'FAIL capture-health: clipping detected or capture failed\n'
        failed=1
    fi

    if [ "$failed" -eq 0 ]; then
        printf '\nPASS preflight: hardware is ready for a bounded output-routing test\n'
    else
        printf '\nFAIL preflight: do not run output-routing tests yet\n'
        return 1
    fi
}

wait_clean() {
    require_root

    attempts="${1:-12}"
    duration="${2:-1}"
    interval="${3:-10}"
    ntfy_topic="${4:-}"
    case "$attempts" in
        ''|*[!0-9]*)
            printf 'wait-clean attempts must be an integer.\n' >&2
            exit 64
            ;;
    esac
    case "$duration" in
        ''|*[!0-9]*)
            printf 'wait-clean capture duration must be an integer number of seconds.\n' >&2
            exit 64
            ;;
    esac
    case "$interval" in
        ''|*[!0-9]*)
            printf 'wait-clean interval must be an integer number of seconds.\n' >&2
            exit 64
            ;;
    esac
    if [ "$attempts" -lt 1 ]; then
        printf 'wait-clean attempts must be at least 1.\n' >&2
        exit 64
    fi

    printf 'UH-7000 wait-clean: polling preflight without playback or mixer writes\n'
    printf 'Attempts=%s capture_seconds=%s interval_seconds=%s\n\n' "$attempts" "$duration" "$interval"

    notified=0
    attempt=1
    while [ "$attempt" -le "$attempts" ]; do
        printf 'wait-clean attempt %s/%s\n' "$attempt" "$attempts"
        if preflight "$duration"; then
            printf '\nPASS wait-clean: clean preflight baseline is available\n'
            return 0
        fi

        if [ "$notified" -eq 0 ] && [ -n "$ntfy_topic" ]; then
            send_manual_action_ntfy "$ntfy_topic" \
                'Please disconnect the UH-7000 output-to-input loopback, fully power-cycle the UH-7000 hardware, reconnect USB, then tell Codex it is done. Output tests are gated because capture is still clipping.'
            notified=1
        fi

        if [ "$attempt" -lt "$attempts" ]; then
            printf '\nWAIT wait-clean: preflight failed; sleeping %ss before retry\n\n' "$interval"
            sleep "$interval"
        fi
        attempt=$((attempt + 1))
    done

    printf '\nFAIL wait-clean: no clean preflight baseline after %s attempt(s)\n' "$attempts"
    printf 'Next step: disconnect output-to-input loopback, power-cycle the UH-7000, reconnect USB, then run sudo uh7000ctl preflight 2.\n'
    exit 1
}

loopback_test() {
