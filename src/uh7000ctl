    duration="${1:-3}"
    tone_db="${2:--60}"
    case "$duration" in
        ''|*[!0-9]*)
            printf 'loopback-test duration must be an integer number of seconds.\n' >&2
            exit 64
            ;;
    esac
    case "$tone_db" in
        -[0-9]*|[0-9]*)
            ;;
        *)
            printf 'loopback-test tone level must be an integer dBFS value.\n' >&2
            exit 64
            ;;
    esac

    preflight 1

    python3 - "$duration" "$tone_db" <<'PY'
import math
import os
import subprocess
import sys
import tempfile
import time

duration = int(sys.argv[1])
tone_db = int(sys.argv[2])
rate = 48000
frequency = 1000.0
playback_channels = 4
capture_channels = 6
sample_bytes = 3
playback_frame_bytes = playback_channels * sample_bytes
capture_frame_bytes = capture_channels * sample_bytes
amplitude = 10 ** (tone_db / 20.0)


def int24le(value: int) -> bytes:
    if value < 0:
        value += 1 << 24
    return bytes((value & 0xFF, (value >> 8) & 0xFF, (value >> 16) & 0xFF))


def read_int24le(data: bytes, offset: int) -> int:
    value = data[offset] | (data[offset + 1] << 8) | (data[offset + 2] << 16)
    if value & 0x800000:
        value -= 1 << 24
    return value


def dbfs(value: float) -> str:
    if value <= 0:
        return "-inf"
    return f"{20 * math.log10(value):.1f}"


playback = tempfile.NamedTemporaryFile(prefix="uh7000-playback-", suffix=".raw", delete=False)
capture = tempfile.NamedTemporaryFile(prefix="uh7000-loopback-", suffix=".raw", delete=False)
playback_path = playback.name
capture_path = capture.name
playback.close()
capture.close()

try:
    frames = rate * duration
    with open(playback_path, "wb") as handle:
        for frame in range(frames):
            sample = int(
                max(-0.999, min(0.999, amplitude * math.sin(2 * math.pi * frequency * frame / rate)))
                * 8388607
            )
            encoded = int24le(sample)
            handle.write(encoded * playback_channels)

    capture_duration = duration + 1
    arecord = subprocess.Popen(
        [
            "arecord",
            "-q",
            "-t",
            "raw",
            "-D",
            "hw:UH7000,0",
            "-f",
            "S24_3LE",
            "-c",
            str(capture_channels),
            "-r",
            str(rate),
            "-d",
            str(capture_duration),
            capture_path,
        ]
    )
    time.sleep(0.2)
    aplay = subprocess.run(
        [
            "aplay",
            "-q",
            "-t",
            "raw",
            "-D",
            "hw:UH7000,0",
            "-f",
            "S24_3LE",
            "-c",
            str(playback_channels),
            "-r",
            str(rate),
            playback_path,
        ],
        timeout=duration + 5,
    )
    arecord_rc = arecord.wait(timeout=capture_duration + 5)
    if aplay.returncode != 0:
        raise SystemExit(f"aplay failed with status {aplay.returncode}")
    if arecord_rc != 0:
        raise SystemExit(f"arecord failed with status {arecord_rc}")

    with open(capture_path, "rb") as handle:
        data = handle.read()
finally:
    for path in (playback_path, capture_path):
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass

capture_frames = len(data) // capture_frame_bytes
if capture_frames == 0:
    raise SystemExit("loopback capture produced no frames")

target_bin = round(capture_frames * frequency / rate)
omega = 2.0 * math.pi * target_bin / capture_frames
coeff = 2.0 * math.cos(omega)

peaks = [0.0] * capture_channels
sums = [0.0] * capture_channels
clips = [0] * capture_channels
goertzel = [[0.0, 0.0] for _ in range(capture_channels)]

for frame in range(capture_frames):
    base = frame * capture_frame_bytes
    for ch in range(capture_channels):
        normalized = read_int24le(data, base + ch * sample_bytes) / 8388608.0
        absolute = abs(normalized)
        peaks[ch] = max(peaks[ch], absolute)
        sums[ch] += normalized * normalized
        if absolute >= 0.999:
            clips[ch] += 1
        s_prev, s_prev2 = goertzel[ch]
        s = normalized + coeff * s_prev - s_prev2
        goertzel[ch] = [s, s_prev]

print(
    f"Loopback test played {frequency:.0f} Hz at {tone_db} dBFS "
    f"for {duration}s through hw:UH7000,0"
)
print(f"Captured {capture_frames} frames at {rate} Hz from hw:UH7000,0")

bad = False
best_tone = 0.0
for ch in range(capture_channels):
    s_prev, s_prev2 = goertzel[ch]
    power = s_prev2 * s_prev2 + s_prev * s_prev - coeff * s_prev * s_prev2
    tone_amplitude = 2.0 * math.sqrt(max(0.0, power)) / capture_frames
    best_tone = max(best_tone, tone_amplitude)
    rms = math.sqrt(sums[ch] / capture_frames)
    if clips[ch]:
        bad = True
    print(
        f"ch{ch + 1}: peak={dbfs(peaks[ch]):>6} dBFS "
        f"rms={dbfs(rms):>6} dBFS 1k={dbfs(tone_amplitude):>6} dBFS "
        f"clips={clips[ch]}"
    )

if best_tone < 10 ** (-90 / 20.0):
    print("FAIL loopback-test: 1 kHz return tone is below -90 dBFS")
    raise SystemExit(1)
if bad:
    print("FAIL loopback-test: captured signal clipped")
    raise SystemExit(1)

print("PASS loopback-test: return tone detected without clipping")
PY
}

report() {
    require_root

    duration="${1:-1}"
    case "$duration" in
        ''|*[!0-9]*)
            printf 'report duration must be an integer number of seconds.\n' >&2
            exit 64
            ;;
    esac

    python3 - "$VID" "$PID" "$duration" <<'PY'
import ctypes
import fcntl
import glob
import json
import math
import os
import re
import subprocess
import sys
import tempfile
import time

vid, pid, duration_raw = sys.argv[1:4]
duration = int(duration_raw)
rate = 48000
channels = 6
sample_bytes = 3
frame_bytes = channels * sample_bytes

USBDEVFS_IOCTL_TYPE = ord("U")
USBDEVFS_IOCTL_NR_CONTROL = 0
IOC_WRITE = 1
IOC_READ = 2
IOC_DIRSHIFT = 30
IOC_SIZESHIFT = 16
IOC_TYPESHIFT = 8
IOC_NRSHIFT = 0


class UsbdevfsCtrlTransfer(ctypes.Structure):
    _fields_ = [
        ("bRequestType", ctypes.c_uint8),
        ("bRequest", ctypes.c_uint8),
        ("wValue", ctypes.c_uint16),
        ("wIndex", ctypes.c_uint16),
        ("wLength", ctypes.c_uint16),
        ("timeout", ctypes.c_uint32),
        ("data", ctypes.c_void_p),
    ]


USBDEVFS_CONTROL = (
    ((IOC_READ | IOC_WRITE) << IOC_DIRSHIFT)
    | (ctypes.sizeof(UsbdevfsCtrlTransfer) << IOC_SIZESHIFT)
    | (USBDEVFS_IOCTL_TYPE << IOC_TYPESHIFT)
    | (USBDEVFS_IOCTL_NR_CONTROL << IOC_NRSHIFT)
)


def read_text(path, default=None):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return handle.read().strip()
    except OSError:
        return default


def vendor_read(devpath, request, value, index, length):
    buf = ctypes.create_string_buffer(length)
    transfer = UsbdevfsCtrlTransfer(
        0xC0,
        request,
        value,
        index,
        length,
        1000,
        ctypes.cast(buf, ctypes.c_void_p).value,
    )
    fd = os.open(devpath, os.O_RDWR)
    try:
        transferred = fcntl.ioctl(fd, USBDEVFS_CONTROL, transfer)
    finally:
        os.close(fd)
    return bytes(buf.raw[:transferred])


def parse_playback_feedback(path, text):
    section_match = re.search(r"(?ms)^Playback:\n(?P<body>.*?)(?:^Capture:|\Z)", text)
    if not section_match:
        return {
            "path": path,
            "present": False,
            "explicit_feedback": False,
            "recommendation": "UH-7000 playback section was not found in ALSA stream text",
        }
    section = section_match.group("body")

    def line_value(label):
        match = re.search(rf"^[ \t]*{re.escape(label)}:[ \t]*(.+)$", section, re.MULTILINE)
        return match.group(1).strip() if match else None

    sync_endpoint = line_value("Sync Endpoint")
    implicit_feedback = line_value("Implicit Feedback Mode")
    endpoint_match = re.search(r"0x([0-9a-fA-F]+)", sync_endpoint or "")
    endpoint_address = f"0x{endpoint_match.group(1).lower()}" if endpoint_match else None
    explicit_feedback = endpoint_address == "0x85" and implicit_feedback == "No"
    if explicit_feedback:
        recommendation = "explicit UH-7000 feedback endpoint is active"
    else:
        recommendation = (
            "reload snd_usb_audio with implicit_fb=N before output loopback tests"
        )
    return {
        "path": path,
        "present": True,
        "sync_endpoint": sync_endpoint,
        "sync_endpoint_address": endpoint_address,
        "implicit_feedback_mode": implicit_feedback,
        "explicit_feedback": explicit_feedback,
        "recommendation": recommendation,
    }


def analyze_capture():
    with tempfile.NamedTemporaryFile(prefix="uh7000-report-", suffix=".raw", delete=False) as tmp:
        path = tmp.name
    try:
        result = subprocess.run(
            [
                "arecord",
                "-q",
                "-t",
                "raw",
                "-D",
                "hw:UH7000,0",
                "-f",
                "S24_3LE",
                "-c",
                str(channels),
                "-r",
                str(rate),
                "-d",
                str(duration),
                path,
            ],
            timeout=duration + 5,
        )
        if result.returncode != 0:
            return {"ok": False, "error": f"arecord exited {result.returncode}"}
        with open(path, "rb") as handle:
            data = handle.read()
    finally:
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass

    frames = len(data) // frame_bytes
    if frames == 0:
        return {"ok": False, "error": "capture produced no frames"}

    peaks = [0.0] * channels
    sums = [0.0] * channels
    clips = [0] * channels
    for frame in range(frames):
        base = frame * frame_bytes
        for ch in range(channels):
            off = base + ch * sample_bytes
            value = data[off] | (data[off + 1] << 8) | (data[off + 2] << 16)
            if value & 0x800000:
                value -= 1 << 24
            normalized = value / 8388608.0
            absolute = abs(normalized)
            peaks[ch] = max(peaks[ch], absolute)
            sums[ch] += normalized * normalized
            if absolute >= 0.999:
                clips[ch] += 1

    per_channel = []
    clipped = False
    clipped_channels = []
    clip_count_total = 0
    for ch in range(channels):
        rms = math.sqrt(sums[ch] / frames)
        if clips[ch] > 0:
            clipped = True
            clipped_channels.append(ch + 1)
            clip_count_total += clips[ch]
        per_channel.append(
            {
                "channel": ch + 1,
                "peak_dbfs": None if peaks[ch] <= 0 else round(20 * math.log10(peaks[ch]), 1),
                "rms_dbfs": None if rms <= 0 else round(20 * math.log10(rms), 1),
                "clips": clips[ch],
            }
        )
    if not clipped_channels:
        clip_pattern = "none"
        recommendation = "capture baseline is clean"
    elif clipped_channels == list(range(1, channels + 1)):
        clip_pattern = "all-channels"
        recommendation = (
            "do not run output tests; disconnect loopback, power-cycle the UH-7000, "
            "then run sudo uh7000ctl preflight 2"
        )
    elif clipped_channels == [1, 3, 5]:
        clip_pattern = "odd-input-mirror"
        recommendation = (
            "do not run output tests; disconnect loopback, power-cycle the UH-7000, "
            "then run sudo uh7000ctl preflight 2"
        )
    elif clipped_channels == [2, 4, 6]:
        clip_pattern = "even-input-mirror"
        recommendation = (
            "do not run output tests; disconnect loopback, power-cycle the UH-7000, "
            "then run sudo uh7000ctl preflight 2"
        )
    else:
        clip_pattern = "partial"
        recommendation = (
            "do not run output tests; reduce input/output level or disconnect loopback, "
            "then run sudo uh7000ctl preflight 2"
        )
    return {
        "ok": not clipped,
        "rate": rate,
        "frames": frames,
        "format": "S24_3LE",
        "channels": channels,
        "clipped_channels": clipped_channels,
        "clip_count_total": clip_count_total,
        "clip_pattern": clip_pattern,
        "recommendation": recommendation,
        "per_channel": per_channel,
    }


devices = []
for path in glob.glob("/sys/bus/usb/devices/*"):
    if read_text(os.path.join(path, "idVendor")) != vid:
        continue
    if read_text(os.path.join(path, "idProduct")) != pid:
        continue
    bus = read_text(os.path.join(path, "busnum"))
    dev = read_text(os.path.join(path, "devnum"))
    devnode = None
    selector = None
    selector_error = None
    if bus and dev:
        devnode = f"/dev/bus/usb/{int(bus):03d}/{int(dev):03d}"
        try:
            payload = vendor_read(devnode, 0x49, 0, 0, 1)
            selector = payload[0] if payload else None
        except OSError as exc:
            selector_error = str(exc)
    drivers = {}
    for iface in ("0", "1", "2", "3"):
        link = f"{path}:2.{iface}/driver"
        drivers[f"2.{iface}"] = os.path.basename(os.path.realpath(link)) if os.path.islink(link) else None
    devices.append(
        {
            "sysfs": path,
            "manufacturer": read_text(os.path.join(path, "manufacturer")),
            "product": read_text(os.path.join(path, "product")),
            "speed_mbps": read_text(os.path.join(path, "speed")),
            "configuration": read_text(os.path.join(path, "bConfigurationValue")),
            "num_configurations": read_text(os.path.join(path, "bNumConfigurations")),
            "devnode": devnode,
            "drivers": drivers,
            "vendor_selector_0x49": selector,
            "vendor_selector_error": selector_error,
        }
    )

alsa_cards = read_text("/proc/asound/cards", "")
stream_reports = []
playback_feedback = None
for stream in glob.glob("/proc/asound/card*/stream*"):
    body = read_text(stream, "")
    if "UH-7000" in body or "TASCAM" in body or "TEAC" in body:
        feedback = parse_playback_feedback(stream, body)
        stream_reports.append({"path": stream, "text": body, "playback_feedback": feedback})
        if playback_feedback is None or feedback.get("explicit_feedback") is True:
            playback_feedback = feedback

if playback_feedback is None:
    playback_feedback = {
        "present": False,
        "explicit_feedback": False,
        "recommendation": "UH-7000 ALSA playback stream was not found",
    }

report = {
    "schema": "tascam-uh7000-report-v1",
    "timestamp": int(time.time()),
    "device_id": f"{vid}:{pid}",
    "devices": devices,
    "alsa": {
        "cards_text": alsa_cards,
        "uh7000_visible": "UH7000" in alsa_cards or "UH-7000" in alsa_cards,
        "streams": stream_reports,
        "playback_feedback": playback_feedback,
    },
    "capture_health": analyze_capture(),
    "safe_for_output_test": False,
}

stream_text = "\n".join(item["text"] for item in stream_reports)
report["safe_for_output_test"] = (
    bool(devices)
    and all(device.get("configuration") == "2" for device in devices)
    and all(
        device.get("drivers", {}).get(iface) == "snd-usb-audio"
        for device in devices
        for iface in ("2.0", "2.1", "2.2")
    )
    and "Format: S24_3LE" in stream_text
    and "Channels: 4" in stream_text
    and "Channels: 6" in stream_text
    and report["alsa"]["playback_feedback"].get("explicit_feedback") is True
    and report["capture_health"].get("ok") is True
)

print(json.dumps(report, indent=2, sort_keys=True))
PY
}

usage() {
    cat <<EOF
Usage: uh7000ctl COMMAND

Commands:
  status                Show USB configuration, driver binding, and ALSA visibility
  configure             Switch the UH-7000 to USB Audio 2.0 configuration 2
  control-status        Read verified vendor control-plane status
  state-dump [DIR]      Read verified 0x55 vendor state pages to DIR
  control-plan [NAME]   Print a decoded dry-run control plan (quiet, noise-mute, adcdac, routes, f800)
  f800-upload IMAGE     Experimentally write verified 0xf800 image pages with backup
  f800-restore IMAGE    Restore a saved 0xf800 page backup
  preflight [SEC]       Check the safe gate before output-routing tests
  loopback-test [SEC] [DBFS]
                        Gate on preflight, then play/capture a low 1 kHz tone
  report [SEC]          Print a JSON diagnostic report without playback/writes
  quiet                 Clear verified vendor mixer blocks to stop USB-side overload
  suppress-noise [SEC]  Apply 0x4d-only recovery for constant clipped output noise
  recover [SEC]         Run quiet recovery with before/after capture checks
  wait-clean [TRIES] [SEC] [INTERVAL] [NTFY_TOPIC]
                        Poll preflight until capture is clean; optionally notify once
  input-noise [SEC]     Capture input only and report noise/clipping spectrum
  capture-health [SEC]  Record input briefly and report per-channel levels/clips
  help                  Show this help
EOF
}

case "${1:-status}" in
    status)
        status
        ;;
    configure)
        shift || true
        configure "${1:-}"
        ;;
    control-status)
        control_status
        ;;
    state-dump)
        shift || true
        state_dump "${1:-/tmp}"
        ;;
    control-plan)
        shift || true
        control_plan "${1:-adcdac}"
        ;;
    f800-upload)
        shift || true
        f800_upload "${1:-}"
        ;;
    f800-restore)
        shift || true
        f800_restore "${1:-}"
        ;;
    preflight)
        shift || true
        preflight "${1:-2}"
        ;;
    loopback-test)
        shift || true
        loopback_test "${1:-3}" "${2:--60}"
        ;;
    report)
        shift || true
        report "${1:-1}"
        ;;
    quiet)
        quiet_mixer
        ;;
    suppress-noise|noise-mute)
        shift || true
        suppress_noise "${1:-2}"
        ;;
    recover)
        shift || true
        recover "${1:-1}"
        ;;
    wait-clean)
        shift || true
        wait_clean "${1:-12}" "${2:-1}" "${3:-10}" "${4:-}"
        ;;
    input-noise)
        shift || true
        input_noise "${1:-4}"
        ;;
    capture-health)
        shift || true
        capture_health "${1:-2}"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac
