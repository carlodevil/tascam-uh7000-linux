suppress_noise() {
    require_root

    duration="${1:-2}"
    case "$duration" in
        ''|*[!0-9]*)
            printf 'suppress-noise duration must be an integer number of seconds.\n' >&2
            exit 64
            ;;
    esac

    printf 'UH-7000 suppress-noise: no playback or request 0x42 will be sent\n'
    printf 'Recovery action: capture check -> Windows-derived 0x4d noise-mute block -> capture check\n\n'

    printf 'Before suppress-noise:\n'
    if capture_health "$duration"; then
        printf 'PASS suppress-noise-before: capture is already clean\n'
    else
        printf 'WARN suppress-noise-before: capture is clipped or capture failed\n'
    fi

    printf '\nApplying 0x4d-only noise suppression block:\n'
    suppress_noise_mixer

    sleep 1

    printf '\nAfter suppress-noise:\n'
    if capture_health "$duration"; then
        printf 'PASS suppress-noise: capture is clean after 0x4d-only recovery\n'
        printf 'Note: this is a recovery/mute gate; it does not prove USB playback routing is fixed.\n'
    else
        printf 'FAIL suppress-noise: capture still clips or capture failed after recovery\n'
        exit 1
    fi
}

recover() {
    require_root

    duration="${1:-1}"
    case "$duration" in
        ''|*[!0-9]*)
            printf 'recover duration must be an integer number of seconds.\n' >&2
            exit 64
            ;;
    esac

    printf 'UH-7000 recovery: no output playback or experimental mixer payload will be sent\n'
    printf 'Recovery action: capture check -> quiet mixer blocks -> capture check\n\n'

    printf 'Before quiet:\n'
    if capture_health "$duration"; then
        printf 'PASS recover-before: capture is not clipped before recovery\n'
        before_ok=1
    else
        printf 'WARN recover-before: capture is clipped or capture failed\n'
        before_ok=0
    fi

    printf '\nApplying verified quiet mixer blocks:\n'
    quiet_mixer

    sleep 1

    printf '\nAfter quiet:\n'
    if capture_health "$duration"; then
        if [ "$before_ok" -eq 1 ]; then
            printf 'PASS recover: capture stayed clean after quiet\n'
        else
            printf 'PASS recover: capture clipping cleared after quiet\n'
        fi
    else
        printf 'FAIL recover: capture still clips or capture failed after quiet\n'
        printf 'Next step: disconnect output-to-input loopback, power-cycle the UH-7000, reconnect USB, then run sudo uh7000ctl preflight 2.\n'
        exit 1
    fi
}

send_manual_action_ntfy() {
    topic="$1"
    message="$2"

    [ -n "$topic" ] || return 0
    case "$topic" in
        *[!A-Za-z0-9_-]*)
            printf 'WARN ntfy: topic contains unsupported characters; notification skipped\n' >&2
            return 0
            ;;
    esac
    if ! command -v curl >/dev/null 2>&1; then
        printf 'WARN ntfy: curl is unavailable; notification skipped\n' >&2
        return 0
    fi

    if curl -fsS \
        -H 'Title: UH-7000 manual action needed' \
        -d "$message" \
        "https://ntfy.sh/$topic" >/dev/null; then
        printf 'Sent ntfy notification to %s\n' "$topic"
    else
        printf 'WARN ntfy: notification to %s failed\n' "$topic" >&2
    fi
}

